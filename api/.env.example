# Database
# Historic data is loopback-only and never enabled by this flag in production.
NETWORK_ACCESS=internal
# Separate server key, restricted to Routes API and server IPs. Never put in Vite.
GOOGLE_ROUTES_API_KEY=
GOOGLE_ROUTES_REQUESTS_PER_MINUTE=160
WEB_CONCURRENCY=1

DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=basis_transport

# JWT
JWT_SECRET=

# Email
RESEND_API_KEY=
RESEND_FROM=

# Client app URL
CLIENT_APP_URL=http://localhost:5173

# Pindo SMS Service
PINDO_API_URL=https://api.pindo.io/v1/sms/
PINDO_TOKEN=your_pindo_api_token_here
PINDO_SENDER_ID=Transport
